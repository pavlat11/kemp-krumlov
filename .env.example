# Kemp Krumlov – nastavení serveru (vzor).
# Zkopírujte jako .env a doplňte skutečné hodnoty. Soubor .env se NIKDY nenahrává na GitHub.
# Patří sem jen nastavení a hesla. Obsah webu (texty, ceník, fotky, rezervace)
# je v databázi, aby ho šlo měnit v administraci.

APP_NAME="Kemp Krumlov"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.kemp-krumlov.cz
APP_KEY=
APP_LOCALE=cs
APP_TIMEZONE=Europe/Prague

# Databáze (údaje od hostingu)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kemp_krumlov
DB_USERNAME=
DB_PASSWORD=

# Odesílání e-mailů (potvrzení rezervací, upozornění na novou poptávku)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=rezervace@kemp-krumlov.cz
MAIL_FROM_NAME="Kemp Krumlov"
# kam chodí upozornění na nové poptávky
KEMP_NOTIFY_EMAIL=kempkrumlov2017@gmail.com

# První správce (vytvoří se při instalaci, heslo pak změňte v administraci)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mapy.cz – odkaz na vloženou mapu v sekci Kontakt
MAPY_EMBED_URL=https://mapy.com/s/laranobohe

# Fotky: maximální rozměr a kvalita při nahrání
GALERIE_MAX_PX=1920
GALERIE_KVALITA=82
