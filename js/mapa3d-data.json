{"items": [{"k": "parking", "n": "Parkoviště", "c": "#55606b", "m": [600, 560], "r": [344, 444, 510, 416], "d": "Parkoviště u vjezdu do kempu, hned vedle občerstvení. Do historického centra dojdete pěšky.", "li": ["Auto 200 Kč / den", "Autobus 500 Kč / den – zdarma, pokud cestující bydlí v kempu", "Parkovné platí do 24:00 daného dne"]}, {"k": "kiosek", "n": "Kiosek a občerstvení", "c": "#e0912f", "m": [1030, 560], "r": [876, 480.32000732421875, 308, 342.67999267578125], "d": "Občerstvení přímo v kempu s posezením u vody. Kousek odtud vyplouvají lodě z půjčovny.", "li": ["Občerstvení a pití", "Posezení s výhledem na řeku", "Úschovna bagáže 50 Kč / batoh"]}, {"k": "wc", "n": "Toalety", "c": "#5d6fb8", "m": [976, 330], "r": [860, 274, 264, 172], "d": "Nové sociální zařízení s WC a sprchami, pár kroků od louky i chatek.", "li": ["Nové sprchy a WC", "Sprcha na mince: 20 Kč / 4 minuty"]}, {"k": "pujcovna", "n": "Půjčovna lodí PE-LA", "c": "#1f6f9a", "m": [344, 862], "r": [-200, 339.3599853515625, 661.6000366210938, 740.6400146484375], "d": "Půjčovna lodí a raftů PE-LA hned za parkovištěm. Zapůjčíte si kánoe nebo raft a zajistí i přepravu osob a bagáže.", "li": ["Kánoe a rafty", "Přeprava osob a bagáže", "Hned vedle parkoviště"]}, {"k": "lode", "n": "Přístaviště", "c": "#2a8bb0", "m": [1880, 750], "r": [940, 684, 1600, 288], "d": "Přistát můžete kdekoli podél břehu kempu. Lodě necháte na trávě u vody, pár kroků od stanu i kiosku.", "li": ["Přistání po celé délce břehu", "Lodě necháte na břehu u kempu", "Vltava, ř. km 280,9"]}, {"k": "kotva", "n": "Kotviště", "c": "#2f6fb0", "m": [470, 1100], "r": [300, 922, 368, 246], "d": "Kotviště je pláž a břeh řeky pod parkovištěm. Zakotvíte loď a máte to kousek do kempu.", "li": ["Pláž a břeh pod parkovištěm", "Bez mola, bez vyznačení bójemi"]}, {"k": "recepce", "n": "Recepce", "c": "#b6513e", "m": [902, 652], "r": [860, 650, 88, 146], "d": "Recepce kempu u vjezdu s malou budkou a závorou. Tady se ubytujete a vyřídíte pobyt.", "li": [